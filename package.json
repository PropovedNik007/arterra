{
	"name": "arterra",
	"version": "0.0.1",
	"private": true,
	"packageManager": "npm@11.19.0",
	"scripts": {
		"dev": "node scripts/build-graph.mjs && vite dev",
		"build": "node scripts/build-graph.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check 'src/**/*.{js,ts,svelte,css}' 'scripts/**/*.mjs' '*.{js,ts,json}' && eslint .",
		"format": "prettier --write .",
		"deploy": "gh-pages -d build -t true",
		"github:refresh": "node scripts/build-github.mjs",
		"github:orgs": "node scripts/build-github-orgs.mjs"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^4.5.10",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/eslint": "^9.6.0",
		"@types/node": "^20.14.15",
		"eslint": "^9.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"gh-pages": "^6.1.1",
		"globals": "^17.11.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.5",
		"typescript": "^5.5.4",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.2.10",
		"@fontsource/hanken-grotesk": "^5.2.8",
		"chroma-js": "^3.2.0",
		"d3-force": "^3.0.0",
		"d3-sankey": "^0.12.3",
		"graphology": "^0.26.0",
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"rehype-highlight": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.0",
		"sigma": "^3.0.3",
		"unified": "^11.0.5"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
